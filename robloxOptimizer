    )

    updateEffectText()
end

local function applyLightingMode()
    if lightingHeartbeatConnection then
        disconnect(lightingHeartbeatConnection)
        lightingHeartbeatConnection = nil
    end

    local mode = config.modeIndex
    local level = math.clamp(config.effectLevel, 1, 10)

    if mode == 2 then
        Lighting.Brightness = originalLighting.Brightness
        Lighting.ClockTime = originalLighting.ClockTime
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.Ambient = originalLighting.Ambient
        Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
        Lighting.ExposureCompensation = originalLighting.ExposureCompensation
        Lighting.GlobalShadows = config.lessVfxEnabled
            and false
            or originalLighting.GlobalShadows

    elseif mode == 1 then
        local ambient = 0.2 + (level * 0.075)

        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
        Lighting.Brightness = 1 + (level * 0.45)
        Lighting.Ambient = Color3.new(ambient, ambient, ambient)
        Lighting.OutdoorAmbient = Color3.new(ambient, ambient, ambient)
        Lighting.ExposureCompensation = level * 0.22

    elseif mode == 3 then
        local ambient = math.clamp(0.6 - (level * 0.055), 0, 1)

        Lighting.ClockTime = 0
        Lighting.GlobalShadows = not config.lessVfxEnabled
        Lighting.FogEnd = math.max(400, 3000 - (level * 260))
        Lighting.Brightness = math.clamp(1.5 - (level * 0.13), 0, 10)
        Lighting.Ambient = Color3.new(ambient, ambient, ambient)
        Lighting.OutdoorAmbient = Color3.new(ambient, ambient, ambient)
        Lighting.ExposureCompensation = -(level * 0.28)
    end

    updateModeUI()
end

local function setLightingMode(mode)
    if not VALID_MODES[mode] then
        mode = 2
    end

    config.modeIndex = mode
    saveConfig()
    applyLightingMode()
end

--// Player character cache for faster "other player" checks
local otherCharacterSet = {}

--// Hide Players
local hidePlayerConnections = {}

local function rememberHidden(instance, property)
    rememberProperty(savedHiddenPlayers, instance, property)
end

local function applyHideToInstance(instance)
    if not instance or not instance.Parent or not config.hidePlayersEnabled then
        return
    end

    if instance:IsA("BasePart") then
        rememberHidden(instance, "LocalTransparencyModifier")
        instance.LocalTransparencyModifier = 1

    elseif instance:IsA("Decal") or instance:IsA("Texture") then
        rememberHidden(instance, "Transparency")
        instance.Transparency = 1

    elseif instance:IsA("BillboardGui") or instance:IsA("SurfaceGui") then
        rememberHidden(instance, "Enabled")
        instance.Enabled = false
    end
end

local function applyHideToCharacter(character)
    if not character or not character.Parent then
        return
    end

    for _, instance in ipairs(character:GetDescendants()) do
        applyHideToInstance(instance)
    end
end

local function clearHideConnections()
    for key, connection in pairs(hidePlayerConnections) do
        disconnect(connection)
        hidePlayerConnections[key] = nil
    end
end

local function setupHideForPlayer(playerObject)
    local character = playerObject.Character

    if character then
        task.defer(function()
            if config.hidePlayersEnabled and character.Parent then
                applyHideToCharacter(character)
            end
        end)

        if not hidePlayerConnections[playerObject] then
            hidePlayerConnections[playerObject] = connect(
                character.DescendantAdded,
                function(instance)
                    task.defer(function()
                        applyHideToInstance(instance)
                    end)
                end
            )
        end
    end
end

local function applyHidePlayers(enabled)
    config.hidePlayersEnabled = enabled
    saveConfig()

    hidePlayersButton.Text = "Hide All Players: " .. (enabled and "ON" or "OFF")
    setButtonState(hidePlayersButton, enabled)

    clearHideConnections()

    if enabled then
        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= player then
                setupHideForPlayer(otherPlayer)
            end
        end
    else
        restoreStorage(savedHiddenPlayers)
    end
end

--// Less VFX
local function isVfx(instance)
    return instance:IsA("ParticleEmitter")
        or instance:IsA("Trail")
        or instance:IsA("Smoke")
        or instance:IsA("Fire")
        or instance:IsA("Sparkles")
        or instance:IsA("Beam")
        or instance:IsA("SelectionBox")
end

local function isShadowCaster(instance)
    return instance:IsA("BasePart")
end

local function applyVfxToInstance(instance)
    if not config.lessVfxEnabled or not instance or not instance.Parent then
        return
    end

    local localCharacter = player.Character

    if isVfx(instance) and (not localCharacter or not instance:IsDescendantOf(localCharacter)) then
        rememberProperty(savedVfx, instance, "Enabled")
        instance.Enabled = false
        return
    end

    if isShadowCaster(instance) and (not localCharacter or not instance:IsDescendantOf(localCharacter)) then
        rememberProperty(savedVfx, instance, "CastShadow")
        instance.CastShadow = false
        return
    end

    if (instance:IsA("Decal") or instance:IsA("Texture"))
        and isOtherCharacterDescendant(instance) then

        rememberProperty(savedVfx, instance, "Transparency")
        instance.Transparency = 1
        return
    end

    if instance:IsA("BasePart")
        and instance.Name == "Handle"
        and isOtherCharacterDescendant(instance) then

        rememberProperty(savedVfx, instance, "LocalTransparencyModifier")
        instance.LocalTransparencyModifier = 1
    end
end

local function applyLessVFX(enabled)
    config.lessVfxEnabled = enabled
    saveConfig()

    lessVfxButton.Text = "Less VFX: " .. (enabled and "ON" or "OFF")
    setButtonState(lessVfxButton, enabled, Color3.fromRGB(80, 20, 20))

    if enabled then
        for _, instance in ipairs(workspace:GetDescendants()) do
            applyVfxToInstance(instance)
        end
    else
        restoreStorage(savedVfx)
    end

    applyLightingMode()
end

--// Boost FPS
local boostTerrain = nil

local function saveTerrainColors(terrain)
    table.clear(savedTerrainColors)

    for _, material in ipairs(Enum.Material:GetEnumItems()) do
        local ok, color = pcall(function()
            return terrain:GetMaterialColor(material)
        end)

        if ok then
            savedTerrainColors[material] = color
        end
    end
end

local function restoreTerrainColors(terrain)
    if not terrain then
        return
    end

    for material, color in pairs(savedTerrainColors) do
        pcall(function()
            terrain:SetMaterialColor(material, color)
        end)
    end

    table.clear(savedTerrainColors)
end

local function applyBoostToInstance(instance)
    if not config.boostEnabled or not instance or not instance.Parent then
        return
    end

    local localCharacter = player.Character

    if instance:IsA("BasePart")
        and (not localCharacter or not instance:IsDescendantOf(localCharacter)) then

        rememberProperty(savedBoost, instance, "Material")
        rememberProperty(savedBoost, instance, "Reflectance")

        instance.Material = Enum.Material.SmoothPlastic
        instance.Reflectance = 0

    elseif instance:IsA("Decal") or instance:IsA("Texture") then
        rememberProperty(savedBoost, instance, "Transparency")
        instance.Transparency = 1

    elseif isVfx(instance) then
        rememberProperty(savedBoost, instance, "Enabled")
        instance.Enabled = false
    end
end

local function applyBoostFPS(enabled)
    config.boostEnabled = enabled
    saveConfig()

    boostButton.Text = "Boost FPS: " .. (enabled and "ON" or "OFF")
    setButtonState(boostButton, enabled)

    local terrain = workspace:FindFirstChildOfClass("Terrain")

    if enabled then
        if terrain and boostTerrain ~= terrain then
            boostTerrain = terrain
            saveTerrainColors(terrain)

            for material in pairs(savedTerrainColors) do
                pcall(function()
                    terrain:SetMaterialColor(material, Color3.fromRGB(50, 50, 50))
                end)
            end
        end

        for _, instance in ipairs(workspace:GetDescendants()) do
            applyBoostToInstance(instance)
        end
    else
        if terrain and next(savedTerrainColors) ~= nil then
            restoreTerrainColors(terrain)
        else
            table.clear(savedTerrainColors)
        end

        restoreStorage(savedBoost)
        boostTerrain = nil
    end
end

--// Remove Terrain / World Hiding
local function applyTerrainToInstance(instance)
    if not config.terrainEnabled or not instance or not instance.Parent then
        return
    end

    local localCharacter = player.Character

    if instance:IsA("BasePart")
        and (not localCharacter or not instance:IsDescendantOf(localCharacter)) then

        rememberProperty(savedTerrain, instance, "LocalTransparencyModifier")
        instance.LocalTransparencyModifier = 1

    elseif instance:IsA("Decal") or instance:IsA("Texture") then
        rememberProperty(savedTerrain, instance, "Transparency")
        instance.Transparency = 1
    end
end

local function applyRemoveTerrain(enabled)
    config.terrainEnabled = enabled
    saveConfig()

    terrainButton.Text = "Remove Terrain: " .. (enabled and "ON" or "OFF")
    setButtonState(terrainButton, enabled)

    if enabled then
        for _, instance in ipairs(workspace:GetDescendants()) do
            applyTerrainToInstance(instance)
        end
    else
        restoreStorage(savedTerrain)
    end
end

--// Workspace change handling
-- One DescendantAdded connection handles dynamic objects for all enabled systems.
connect(
    workspace.DescendantAdded,
    function(instance)
        if not (config.terrainEnabled or config.boostEnabled or config.lessVfxEnabled) then
            return
        end

        task.defer(function()
            if config.terrainEnabled then
                applyTerrainToInstance(instance)
            end

            if config.boostEnabled then
                applyBoostToInstance(instance)
            end

            if config.lessVfxEnabled then
                applyVfxToInstance(instance)
            end
        end)
    end
)

--// Player lifecycle / character cache
local function cacheCharacter(playerObject, character)
    if playerObject ~= player and character then
        otherCharacterSet[character] = true
    end

    if config.hidePlayersEnabled and playerObject ~= player and character then
        setupHideForPlayer(playerObject)
    end

    if config.lessVfxEnabled and playerObject ~= player and character then
        task.defer(function()
            if not character.Parent then
                return
            end

            for _, instance in ipairs(character:GetDescendants()) do
                applyVfxToInstance(instance)
            end
        end)
    end
end

local function watchPlayer(playerObject)
    if playerObject == player then
        return
    end

    if playerObject.Character then
        cacheCharacter(playerObject, playerObject.Character)
    end

    connect(playerObject.CharacterAdded, function(character)
        task.wait(0.2)

        cacheCharacter(playerObject, character)
    end)
end

