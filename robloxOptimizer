--// HTTP helper for executor environments
local function executorRequest(url)
    local requestFunction =
        getExecutorFunction("request")
        or getExecutorFunction("http_request")

    if not requestFunction and type(syn) == "table" and type(syn.request) == "function" then
        requestFunction = syn.request
    end

    if type(requestFunction) == "function" then
        local ok, response = pcall(function()
            return requestFunction({
                Url = url,
                Method = "GET",
            })
        end)

        if ok and type(response) == "table" then
            local statusCode = tonumber(response.StatusCode or response.Status)
            local body = response.Body or response.body

            if body and (not statusCode or (statusCode >= 200 and statusCode < 300)) then
                return body
            end
        end
    end

    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)

    return ok and body or nil
end

local function getPublicServers(placeId, sortOrder, maxPages)
    local servers = {}
    local cursor = nil

    for _ = 1, (maxPages or 3) do
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100")
            :format(placeId, sortOrder)

        if cursor then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local raw = executorRequest(url)
        if not raw then
            break
        end

        local decoded
        local ok = pcall(function()
            decoded = HttpService:JSONDecode(raw)
        end)

        if not ok or type(decoded) ~= "table" or type(decoded.data) ~= "table" then
            break
        end

        for _, server in ipairs(decoded.data) do
            table.insert(servers, server)
        end

        cursor = decoded.nextPageCursor
        if not cursor or cursor == "" then
            break
        end
    end

    return servers
end

--// Teleport UI state
local teleportBusy = false

local function setTeleportButton(button, text, busy)
    button.Text = text
    button.AutoButtonColor = not busy
