local function rememberProperty(storage, instance, property)
    local entry = storage[instance]
    if not entry then
        entry = {}
        storage[instance] = entry
    end

    if entry[property] == nil then
        local ok, value = pcall(function()
            return instance[property]
        end)

        if ok then
            entry[property] = value
        end
    end
end

local function restoreStorage(storage)
    for instance, properties in pairs(storage) do
        if instance and instance.Parent then
            for property, originalValue in pairs(properties) do
                pcall(function()
                    instance[property] = originalValue
                end)
            end
        end
    end

    table.clear(storage)
end

