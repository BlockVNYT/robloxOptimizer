end)

local function teleportToServer(serverId, button, activeText, defaultText)
    if teleportBusy then
        return false
    end

    teleportBusy = true
    setTeleportButton(button, activeText, true)

    local ok = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, player)
    end)

    if not ok then
        teleportBusy = false
        resetTeleportButton(button, defaultText)
        return false
    end

    return true
end

local function hopNormal()
    local placeId = game.PlaceId
    local currentJobId = game.JobId

    local servers = getPublicServers(placeId, "Asc", 3)

    for _, server in ipairs(servers) do
        local playing = tonumber(server.playing)
        local maxPlayers = tonumber(server.maxPlayers)

        if server.id ~= currentJobId
            and playing
            and maxPlayers
            and playing < maxPlayers then

            return teleportToServer(
                server.id,
                hopButton,
                "Hopping...",
                "Hop Server"
            )
        end
    end

    -- Fallback: ask Roblox to place the player into another public server.
    local ok = pcall(function()
        TeleportService:Teleport(placeId, player)
    end)

    if not ok then
        teleportBusy = false
        resetTeleportButton(hopButton, "Hop Server")
        return false
    end

    setTeleportButton(hopButton, "Hopping...", true)
    return true
end

local function hopLessPlayers()
    local placeId = game.PlaceId
    local currentJobId = game.JobId

    local servers = getPublicServers(placeId, "Asc", 6)

    local bestServerId = nil
    local lowestPlayers = math.huge

    for _, server in ipairs(servers) do
        local playing = tonumber(server.playing)
        local maxPlayers = tonumber(server.maxPlayers)

        if server.id ~= currentJobId
            and playing
            and maxPlayers
            and playing > 0
            and playing < maxPlayers
            and playing < lowestPlayers then

            lowestPlayers = playing
            bestServerId = server.id
        end
    end

    if bestServerId then
        return teleportToServer(
            bestServerId,
            hopLessButton,
            "Searching...",
            "Hop Server (Less)"
        )
    end

    -- Fallback.
    local ok = pcall(function()
        TeleportService:Teleport(placeId, player)
    end)

    if not ok then
        teleportBusy = false
        resetTeleportButton(hopLessButton, "Hop Server (Less)")
        return false
    end

    setTeleportButton(hopLessButton, "Searching...", true)
    return true
end

local function rejoinServer()
    if teleportBusy then
        return
    end

    teleportBusy = true
    setTeleportButton(rejoinButton, "Rejoining...", true)

    local ok = pcall(function()
        if #Players:GetPlayers() <= 1 then
            TeleportService:Teleport(game.PlaceId, player)
        else
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
        end
    end)

    if not ok then
        teleportBusy = false
        resetTeleportButton(rejoinButton, "Rejoin Server")
    end
end

