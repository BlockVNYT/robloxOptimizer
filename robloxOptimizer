local function getExecutorFunction(name)
    local value = ENV[name]
    if type(value) == "function" then
        return value
    end

    value = rawget(_G, name)
    return type(value) == "function" and value or nil
end

local function loadConfig()
    local isfileFn = getExecutorFunction("isfile")
    local readfileFn = getExecutorFunction("readfile")

    if not isfileFn or not readfileFn then
        return
    end

    local ok, exists = pcall(isfileFn, CONFIG_FILE)
    if not ok or not exists then
        return
    end

    local success, raw = pcall(readfileFn, CONFIG_FILE)
    if not success or type(raw) ~= "string" then
        return
    end

    local decodeOk, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
    if not decodeOk or type(decoded) ~= "table" then
        return
    end

    for key, value in pairs(decoded) do
        if config[key] ~= nil and typeof(value) == typeof(config[key]) then
            config[key] = value
        end
    end

    config.modeIndex = VALID_MODES[config.modeIndex] and config.modeIndex or 2
    config.effectLevel = math.clamp(tonumber(config.effectLevel) or 5, 1, 10)
end

local saveQueued = false

local function writeConfig()
    local writefileFn = getExecutorFunction("writefile")
    if not writefileFn then
        return
    end

    pcall(function()
        writefileFn(CONFIG_FILE, HttpService:JSONEncode(config))
    end)
end

local function saveConfig()
    -- Avoid multiple file writes during rapid button presses.
    if saveQueued then
        return
    end

    saveQueued = true

    task.delay(0.15, function()
        saveQueued = false

        if type(ENV.BlockVNHubCleanup) ~= "function" then
            return
        end

        writeConfig()
    end)
end

