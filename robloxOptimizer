--// FPS + Ping monitor
local fpsAccumulator = 0
local fpsFrames = 0
local fpsUpdateTimer = 0
local rainbowTimer = 0

connect(RunService.RenderStepped, function(deltaTime)
    fpsFrames += 1
    fpsAccumulator += deltaTime
    fpsUpdateTimer += deltaTime
    rainbowTimer += deltaTime

    if fpsUpdateTimer >= 0.25 then
        local fps = 0

        if fpsAccumulator > 0 then
            fps = math.floor(fpsFrames / fpsAccumulator + 0.5)
        end

        fpsFrames = 0
        fpsAccumulator = 0
        fpsUpdateTimer = 0

        if config.fpsPingEnabled and fpsLabel.Parent then
            local ping = 0

            pcall(function()
                local networkStats = Stats:FindFirstChild("Network")
                local serverStats = networkStats
                    and networkStats:FindFirstChild("ServerStatsItem")

                local pingStat = serverStats
                    and serverStats:FindFirstChild("Data Ping")

                if pingStat then
                    local valueString = pingStat:GetValueString()
                    local number = tonumber(valueString:match("(%d+%.?%d*)"))
                    ping = number and math.floor(number + 0.5) or 0
                end
            end)

            fpsLabel.Text = ("FPS: %d | Ping: %d ms"):format(fps, ping)
        end
    end

    if rainbowTimer >= 0.05 then
        rainbowTimer = 0

        local hue = (os.clock() % 5) / 5
        local rainbowColor = Color3.fromHSV(hue, 1, 1)

        for index = #rainbowStrokes, 1, -1 do
            local stroke = rainbowStrokes[index]

            if stroke and stroke.Parent then
                stroke.Color = rainbowColor
            else
                table.remove(rainbowStrokes, index)
            end
        end

        if fpsLabel.Parent then
            fpsLabel.TextColor3 = rainbowColor
        end
    end
end)

