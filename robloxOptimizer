--// Global cleanup for safe reruns / removal.
local cleanedUp = false

ENV.BlockVNHubCleanup = function()
    if cleanedUp then
        return
    end

    cleanedUp = true

    -- Stop callbacks first.
    disconnectAll()

    -- Restore modified instances.
    restoreStorage(savedBoost)
    restoreStorage(savedTerrain)
    restoreStorage(savedVfx)
    restoreStorage(savedHiddenPlayers)

    if next(savedTerrainColors) ~= nil then
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            restoreTerrainColors(terrain)
        end
    end

    -- Restore Lighting.
    pcall(function()
        Lighting.Brightness = originalLighting.Brightness
        Lighting.ClockTime = originalLighting.ClockTime
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.GlobalShadows = originalLighting.GlobalShadows
        Lighting.Ambient = originalLighting.Ambient
        Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
        Lighting.ExposureCompensation = originalLighting.ExposureCompensation
    end)

    table.clear(otherCharacterSet)
    table.clear(hidePlayerConnections)
    table.clear(rainbowStrokes)

    if gui then
        pcall(function()
            gui:Destroy()
        end)
    end

    saveQueued = false

    -- Keep the cleanup entry reusable for a future execution.
    ENV.BlockVNHubCleanup = nil
end
